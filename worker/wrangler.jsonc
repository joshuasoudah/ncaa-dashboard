{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "fbs-board-data",
  "main": "src/index.js",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  // Intended browser origin. Not proof this Worker is deployed.
  "vars": {
    "ALLOWED_ORIGIN": "https://joshuasoudah.github.io"
  }
}
